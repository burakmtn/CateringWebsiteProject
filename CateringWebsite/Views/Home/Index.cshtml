@{
    ViewData["Title"] = "Home";
}

<section class="brand-hero">
    <div class="hero-copy">
        <p class="eyebrow">Catering management workspace</p>
        <h1>SofraLink</h1>
        <p class="lead-text">A role-based catering platform foundation for users, caretakers, menus, orders, and admin workflows.</p>
    </div>
    <div class="hero-panel" aria-label="Project status">
        <span class="status-dot"></span>
        <strong>Core foundation</strong>
        <span>ASP.NET Core MVC, Identity, EF Core, LocalDB</span>
    </div>
</section>

<section class="section-band" id="starter-sections">
    <div class="section-heading">
        <p class="eyebrow">Step 1 foundation</p>
        <h2>Starter structure</h2>
    </div>
    <div class="feature-grid">
        <article class="feature-card">
            <span class="feature-kicker">Identity</span>
            <h3>Users and roles</h3>
            <p>Admin, Caretaker, and User roles are ready for the next feature step.</p>
        </article>
        <article class="feature-card">
            <span class="feature-kicker">Database</span>
            <h3>Code First schema</h3>
            <p>LocalDB migrations include Identity tables and the first menu item table.</p>
        </article>
        <article class="feature-card">
            <span class="feature-kicker">Interface</span>
            <h3>Branded layout</h3>
            <p>Navbar, sidebar, footer, and starter styling establish the project identity.</p>
        </article>
    </div>
</section>
