@model IReadOnlyList<MenuItem>

@{
    ViewData["Title"] = "Available Menus";
}

<section class="dashboard-header">
    <div>
        <p class="eyebrow">User home</p>
        <h1>Available menus</h1>
        <p class="lead-text">Browse the latest menu items created by caretakers.</p>
    </div>
</section>

<section class="menu-grid">
@if (Model.Count == 0)
{
    <div class="empty-state menu-empty">No menus are available yet.</div>
}
else
{
    @foreach (var item in Model)
    {
        <article class="menu-card">
            <div>
                <span class="feature-kicker">@item.Caretaker?.DisplayName</span>
                <h2>@item.Name</h2>
                <p>@item.Description</p>
            </div>
            <strong>@item.Price.ToString("C")</strong>
        </article>
    }
}
</section>
