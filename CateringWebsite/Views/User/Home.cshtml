@model NearbyMenusViewModel

@{
    ViewData["Title"] = "Nearby Menus";
}

<section class="dashboard-header">
    <div>
        <p class="eyebrow">User home</p>
        <h1>Nearby menus</h1>
        <p class="lead-text">Only menus within @Model.NearbyDistanceKm.ToString("0.#") km are shown, calculated with Google Maps Distance Matrix API.</p>
    </div>
    <a class="btn brand-action" asp-controller="Profile" asp-action="Location">Set delivery location</a>
</section>

<section class="feature-grid section-band">
    <article class="feature-card">
        <span class="feature-kicker">Nearby</span>
        <h3>@Model.Stats.NearbyMenuCount menus</h3>
        <p>Menus currently visible within the configured Google Maps distance.</p>
    </article>
    <article class="feature-card">
        <span class="feature-kicker">Orders</span>
        <h3>@Model.Stats.OrderCount purchases</h3>
        <p>Your completed SofraLink order history.</p>
    </article>
    <article class="feature-card">
        <span class="feature-kicker">Spending</span>
        <h3>@Model.Stats.TotalSpent.ToString("C")</h3>
        <p>Total simulated payment amount across your orders.</p>
    </article>
    <article class="feature-card">
        <span class="feature-kicker">Reviews</span>
        <h3>@Model.Stats.ReviewCount ratings</h3>
        <p>Comments tied to completed order items.</p>
    </article>
</section>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="status-message">@Model.StatusMessage</div>
}

<section class="menu-grid">
@if (Model.Menus.Count == 0)
{
    <div class="empty-state menu-empty">No nearby menus are available right now.</div>
}
else
{
    @foreach (var nearbyMenu in Model.Menus)
    {
        var item = nearbyMenu.MenuItem;
        <article class="menu-card">
            @if (!string.IsNullOrWhiteSpace(item.ImagePath))
            {
                <img class="menu-card-image" src="@item.ImagePath" alt="@item.Name" />
            }
            else
            {
                <div class="image-placeholder">SofraLink</div>
            }
            <div>
                <span class="feature-kicker">@item.Caretaker?.DisplayName · @nearbyMenu.DistanceText</span>
                <h2>@item.Name</h2>
                <p>@item.Description</p>
                <div class="rating-line">
                    <span>Menu @nearbyMenu.MenuRating.DisplayText</span>
                    <span>Caretaker @nearbyMenu.CaretakerRating.DisplayText</span>
                </div>
            </div>
            <div class="menu-card-footer">
                <strong>@item.Price.ToString("C")</strong>
                <a class="btn btn-sm btn-light" asp-action="Details" asp-route-id="@item.Id">Details</a>
            </div>
        </article>
    }
}
</section>
