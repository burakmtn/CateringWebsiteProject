@model MenuItemFormViewModel

@{
    ViewData["Title"] = "Create Menu Item";
}

<section class="auth-page">
    <div class="auth-card">
        <p class="eyebrow">Caretaker</p>
        <h1>Create menu item</h1>
        <form asp-action="Create" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-field">
                <label asp-for="Name"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="Price"></label>
                <input asp-for="Price" class="form-control" type="number" min="0.01" step="0.01" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn brand-action">Save menu item</button>
                <a class="btn btn-light" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
