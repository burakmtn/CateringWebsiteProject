@model MenuItemFormViewModel

@{
    ViewData["Title"] = "Edit Menu Item";
}

<section class="auth-page">
    <div class="auth-card menu-form-card">
        <p class="eyebrow">Caretaker</p>
        <h1>Edit menu item</h1>
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data" class="auth-form">
            <input asp-for="Id" type="hidden" />
            <input asp-for="ExistingImagePath" type="hidden" />
            <partial name="_MenuItemFormFields" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn brand-action">Update menu item</button>
                <a class="btn btn-light" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
