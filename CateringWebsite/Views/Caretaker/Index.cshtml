@model CaretakerDashboardViewModel

@{
    ViewData["Title"] = "Caretaker Menus";
}

<section class="dashboard-header">
    <div>
        <p class="eyebrow">Caretaker</p>
        <h1>Menu management</h1>
        <p class="lead-text">Create, edit, and manage menu items with images and customization options.</p>
    </div>
    <a class="btn brand-action" asp-action="Create">Create menu item</a>
</section>

<section class="feature-grid section-band">
    <article class="feature-card">
        <span class="feature-kicker">Menus</span>
        <h3>@Model.MenuItemCount active items</h3>
        <p>Menu records owned by this caretaker account.</p>
    </article>
    <article class="feature-card">
        <span class="feature-kicker">Orders</span>
        <h3>@Model.ReceivedOrderCount received</h3>
        <p>@Model.CompletedOrderCount completed orders include your menu items.</p>
    </article>
    <article class="feature-card">
        <span class="feature-kicker">Revenue</span>
        <h3>@Model.TotalRevenue.ToString("C")</h3>
        <p>Total simulated subtotal from ordered items.</p>
    </article>
    <article class="feature-card">
        <span class="feature-kicker">Ratings</span>
        <h3>@(Model.AverageCaretakerRating is null ? "No ratings" : $"{Model.AverageCaretakerRating:0.0}")</h3>
        <p>@Model.ReviewCount completed-order reviews mention this caretaker.</p>
    </article>
</section>

<form class="table-filter" method="get">
    <input class="form-control" type="search" name="search" value="@Model.MenuItems.Search" placeholder="Filter menu items" />
    <button class="btn brand-action" type="submit">Filter</button>
    <a class="btn btn-light" asp-action="Index">Clear</a>
</form>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="status-message">@statusMessage</div>
}

@if (Model.LocationMissing)
{
    <div class="status-message">
        Set your service location so Google Maps can include your menus in nearby user results.
        <a asp-controller="Profile" asp-action="Location">Set location</a>
    </div>
}

<section class="table-surface">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Price</th>
                <th>Options</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.MenuItems.Items.Count == 0)
        {
            <tr>
                <td colspan="6" class="empty-state">No menu items yet.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model.MenuItems.Items)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                        {
                            <img class="table-thumb" src="@item.ImagePath" alt="@item.Name" />
                        }
                        else
                        {
                            <span class="image-placeholder small-placeholder">SL</span>
                        }
                    </td>
                    <td>
                        <strong>@item.Name</strong>
                        <span class="table-description">@item.Description</span>
                    </td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.CustomizationOptions.Count</td>
                    <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>
                        <div class="table-actions">
                            <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</section>

<nav class="pagination-row" aria-label="Menu table pages">
    <span>Page @Model.MenuItems.PageNumber of @Model.MenuItems.TotalPages (@Model.MenuItems.TotalItems total)</span>
    <div>
        @if (Model.MenuItems.HasPreviousPage)
        {
            <a class="btn btn-sm btn-light" asp-action="Index" asp-route-search="@Model.MenuItems.Search" asp-route-page="@(Model.MenuItems.PageNumber - 1)">Previous</a>
        }
        @if (Model.MenuItems.HasNextPage)
        {
            <a class="btn btn-sm btn-light" asp-action="Index" asp-route-search="@Model.MenuItems.Search" asp-route-page="@(Model.MenuItems.PageNumber + 1)">Next</a>
        }
    </div>
</nav>
