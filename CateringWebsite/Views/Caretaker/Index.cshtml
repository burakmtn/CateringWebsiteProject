@model IReadOnlyList<MenuItem>

@{
    ViewData["Title"] = "Caretaker Menus";
}

<section class="dashboard-header">
    <div>
        <p class="eyebrow">Caretaker</p>
        <h1>Menu creation</h1>
        <p class="lead-text">Create simple menu items that users can see on their home page.</p>
    </div>
    <a class="btn brand-action" asp-action="Create">Create menu item</a>
</section>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="status-message">@statusMessage</div>
}

<section class="table-surface">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>Price</th>
                <th>Description</th>
                <th>Created</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td colspan="4" class="empty-state">No menu items yet.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.Description</td>
                    <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                </tr>
            }
        }
        </tbody>
    </table>
</section>
