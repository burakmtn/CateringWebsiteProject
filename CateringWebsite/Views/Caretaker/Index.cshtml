@model PagedListViewModel<MenuItem>

@{
    ViewData["Title"] = "Caretaker Menus";
}

<section class="dashboard-header">
    <div>
        <p class="eyebrow">Caretaker</p>
        <h1>Menu management</h1>
        <p class="lead-text">Create, edit, and manage menu items with images and customization options.</p>
    </div>
    <a class="btn brand-action" asp-action="Create">Create menu item</a>
</section>

<form class="table-filter" method="get">
    <input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Filter menu items" />
    <button class="btn brand-action" type="submit">Filter</button>
    <a class="btn btn-light" asp-action="Index">Clear</a>
</form>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="status-message">@statusMessage</div>
}

@if (ViewData["LocationMissing"] as bool? == true)
{
    <div class="status-message">
        Set your service location so Google Maps can include your menus in nearby user results.
        <a asp-controller="Profile" asp-action="Location">Set location</a>
    </div>
}

<section class="table-surface">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Price</th>
                <th>Options</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="6" class="empty-state">No menu items yet.</td>
            </tr>
        }
        else
        {
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.ImagePath))
                        {
                            <img class="table-thumb" src="@item.ImagePath" alt="@item.Name" />
                        }
                        else
                        {
                            <span class="image-placeholder small-placeholder">SL</span>
                        }
                    </td>
                    <td>
                        <strong>@item.Name</strong>
                        <span class="table-description">@item.Description</span>
                    </td>
                    <td>@item.Price.ToString("C")</td>
                    <td>@item.CustomizationOptions.Count</td>
                    <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                    <td>
                        <div class="table-actions">
                            <a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        }
        </tbody>
    </table>
</section>

<nav class="pagination-row" aria-label="Menu table pages">
    <span>Page @Model.PageNumber of @Model.TotalPages (@Model.TotalItems total)</span>
    <div>
        @if (Model.HasPreviousPage)
        {
            <a class="btn btn-sm btn-light" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.PageNumber - 1)">Previous</a>
        }
        @if (Model.HasNextPage)
        {
            <a class="btn btn-sm btn-light" asp-action="Index" asp-route-search="@Model.Search" asp-route-page="@(Model.PageNumber + 1)">Next</a>
        }
    </div>
</nav>
