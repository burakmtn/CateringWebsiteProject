@model LocationViewModel

@{
    ViewData["Title"] = "Location";
}

<section class="auth-page">
    <div class="auth-card">
        <p class="eyebrow">Google Maps filtering</p>
        <h1>Set location</h1>
        <form asp-action="Location" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="RoleLabel" type="hidden" />

            <div class="form-field">
                <label asp-for="LocationAddress">@Model.RoleLabel</label>
                <textarea asp-for="LocationAddress" class="form-control" rows="3" placeholder="Street, district, city, country"></textarea>
                <span asp-validation-for="LocationAddress" class="text-danger"></span>
                <span class="field-hint">This address is sent to Google Distance Matrix API for nearby restaurant checks.</span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn brand-action">Save location</button>
                <a class="btn btn-light" asp-controller="Home" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
