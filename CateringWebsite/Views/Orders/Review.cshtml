@model ReviewFormViewModel

@{
    ViewData["Title"] = "Review Order Item";
}

<section class="auth-page">
    <div class="auth-card">
        <p class="eyebrow">Completed order review</p>
        <h1>@Model.MenuName</h1>
        <p class="lead-text">@Model.CaretakerName</p>
        <form asp-action="Review" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input asp-for="OrderItemId" type="hidden" />

            <div class="form-row">
                <div class="form-field">
                    <label asp-for="MenuRating"></label>
                    <input asp-for="MenuRating" class="form-control" type="number" min="1" max="5" />
                    <span asp-validation-for="MenuRating" class="text-danger"></span>
                </div>
                <div class="form-field">
                    <label asp-for="CaretakerRating"></label>
                    <input asp-for="CaretakerRating" class="form-control" type="number" min="1" max="5" />
                    <span asp-validation-for="CaretakerRating" class="text-danger"></span>
                </div>
            </div>

            <div class="form-field">
                <label asp-for="Comment"></label>
                <textarea asp-for="Comment" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Comment" class="text-danger"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn brand-action">Submit review</button>
                <a class="btn btn-light" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
