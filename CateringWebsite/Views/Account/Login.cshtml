@model LoginViewModel

@{
    ViewData["Title"] = "Login";
}

<section class="auth-page">
    <div class="auth-card">
        <p class="eyebrow">Welcome back</p>
        <h1>Login</h1>
        <form asp-action="Login" method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-field">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-field">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <label class="form-check auth-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <span class="form-check-label">@Html.DisplayNameFor(model => model.RememberMe)</span>
            </label>

            <button type="submit" class="btn brand-action auth-submit">Login</button>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
