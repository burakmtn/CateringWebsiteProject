@model CartViewModel

@{
    ViewData["Title"] = "Cart";
    var search = Context.Request.Query["search"].ToString();
    var pageNumber = int.TryParse(Context.Request.Query["page"], out var parsedPage) ? Math.Max(1, parsedPage) : 1;
    var pageSize = 10;
    var filteredItems = string.IsNullOrWhiteSpace(search)
        ? Model.Items.ToList()
        : Model.Items.Where(item =>
            item.MenuName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
            item.CaretakerName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
            item.SelectedOptions.Any(option => option.Contains(search, StringComparison.OrdinalIgnoreCase))).ToList();
    var totalPages = Math.Max(1, (int)Math.Ceiling(filteredItems.Count / (double)pageSize));
    pageNumber = Math.Min(pageNumber, totalPages);
    var visibleItems = filteredItems.Skip((pageNumber - 1) * pageSize).Take(pageSize).ToList();
}

<section class="dashboard-header">
    <div>
        <p class="eyebrow">Cart</p>
        <h1>Your order</h1>
        <p class="lead-text">Review quantities, customization options, subtotals, and total order amount.</p>
    </div>
    @if (Model.Items.Count > 0)
    {
        <a class="btn brand-action" asp-action="Payment">Proceed to payment</a>
    }
</section>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="status-message">@statusMessage</div>
}

@if (Model.Items.Count == 0)
{
    <div class="empty-state menu-empty">Your cart is empty.</div>
}
else
{
    <form class="table-filter" method="get">
        <input class="form-control" type="search" name="search" value="@search" placeholder="Filter cart" />
        <button class="btn brand-action" type="submit">Filter</button>
        <a class="btn btn-light" asp-action="Index">Clear</a>
    </form>
    <section class="table-surface">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Item</th>
                    <th>Options</th>
                    <th>Unit</th>
                    <th>Quantity</th>
                    <th>Subtotal</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
            @if (visibleItems.Count == 0)
            {
                <tr>
                    <td colspan="6" class="empty-state">No cart items match this filter.</td>
                </tr>
            }
            @foreach (var item in visibleItems)
            {
                <tr>
                    <td>
                        <strong>@item.MenuName</strong>
                        <span class="table-description">@item.CaretakerName</span>
                    </td>
                    <td>
                        @if (item.SelectedOptions.Count == 0)
                        {
                            <span class="table-description">No customizations</span>
                        }
                        else
                        {
                            <ul class="compact-list">
                            @foreach (var option in item.SelectedOptions)
                            {
                                <li>@option</li>
                            }
                            </ul>
                        }
                    </td>
                    <td>@item.UnitPrice.ToString("C")</td>
                    <td>
                        <form asp-action="UpdateQuantity" method="post" class="inline-form">
                            <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                            <input class="form-control quantity-input" name="quantity" type="number" value="@item.Quantity" min="1" max="99" />
                            <button class="btn btn-sm btn-light" type="submit">Update</button>
                        </form>
                    </td>
                    <td>@item.Subtotal.ToString("C")</td>
                    <td>
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="cartItemId" value="@item.CartItemId" />
                            <button class="btn btn-sm btn-outline-danger" type="submit">Remove</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </section>
    <nav class="pagination-row" aria-label="Cart table pages">
        <span>Page @pageNumber of @totalPages (@filteredItems.Count total)</span>
        <div>
            @if (pageNumber > 1)
            {
                <a class="btn btn-sm btn-light" asp-action="Index" asp-route-search="@search" asp-route-page="@(pageNumber - 1)">Previous</a>
            }
            @if (pageNumber < totalPages)
            {
                <a class="btn btn-sm btn-light" asp-action="Index" asp-route-search="@search" asp-route-page="@(pageNumber + 1)">Next</a>
            }
        </div>
    </nav>
    <section class="cart-total">
        <span>Total</span>
        <strong>@Model.TotalAmount.ToString("C")</strong>
    </section>
}
