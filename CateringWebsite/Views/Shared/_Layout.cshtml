<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SofraLink</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CateringWebsite.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="topbar">
        <nav class="navbar navbar-expand-lg navbar-light">
            <div class="container-fluid px-4">
                <a class="navbar-brand brand-lockup" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">SL</span>
                    <span>SofraLink</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.IsInRole(AppRoles.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Index">Admin</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="Logs">Logs</a>
                            </li>
                        }
                        @if (User.IsInRole(AppRoles.Caretaker))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Caretaker" asp-action="Index">My menus</a>
                            </li>
                        }
                        @if (User.IsInRole(AppRoles.User))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="User" asp-action="Home">Menus</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Cart" asp-action="Index">Cart</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Orders" asp-action="Index">Orders</a>
                            </li>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Profile" asp-action="Location">Location</a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="app-shell">
        <aside class="sidebar" aria-label="Project sections">
            <a class="sidebar-link active" asp-area="" asp-controller="Home" asp-action="Index">Overview</a>
            @if (User.IsInRole(AppRoles.Admin))
            {
                <a class="sidebar-link" asp-controller="Admin" asp-action="Index">Admin</a>
                <a class="sidebar-link" asp-controller="Admin" asp-action="Logs">System logs</a>
            }
            @if (User.IsInRole(AppRoles.Caretaker))
            {
                <a class="sidebar-link" asp-controller="Caretaker" asp-action="Index">My menus</a>
                <a class="sidebar-link" asp-controller="Caretaker" asp-action="Create">Create menu</a>
                <a class="sidebar-link" asp-controller="Profile" asp-action="Location">Service location</a>
            }
            @if (User.IsInRole(AppRoles.User))
            {
                <a class="sidebar-link" asp-controller="User" asp-action="Home">Available menus</a>
                <a class="sidebar-link" asp-controller="Cart" asp-action="Index">Cart</a>
                <a class="sidebar-link" asp-controller="Orders" asp-action="Index">Order history</a>
                <a class="sidebar-link" asp-controller="Profile" asp-action="Location">Delivery location</a>
            }
            @if (User.Identity?.IsAuthenticated != true)
            {
                <a class="sidebar-link" asp-controller="Account" asp-action="Login">Login</a>
                <a class="sidebar-link" asp-controller="Account" asp-action="Register">Register</a>
            }
        </aside>

        <main class="content-area" role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="container-fluid px-4">
            <span>&copy; 2026 SofraLink</span>
            <span>Catering platform starter</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
